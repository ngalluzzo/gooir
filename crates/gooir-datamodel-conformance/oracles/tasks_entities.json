    "payload": {
      "origin": "git:blob:0ff6995a757b8d773e1f3e092650791b29b7beb4#examples/tasks.entities",
      "text": "# A small task tracker. This file is the whole application definition.\n\nentity Team\n  id        uuid       pk = uuid\n  name      text       unique\n  createdAt timestamp  = now\n\nentity Person\n  id        uuid       pk = uuid\n  email     text       unique\n  name      text\n  teamId    -> Team\n  createdAt timestamp  = now\n\nentity Task\n  id          uuid       pk = uuid\n  title       text\n  notes       text?\n  status      enum TaskStatus(todo, doing, blocked, done) = todo\n  priority    integer   = 3\n  dueOn       date?\n  assigneeId  -> Person\n  teamId      -> Team\n  createdAt   timestamp  = now\n  unique(title, teamId)\n"
    }
  },
