# A small task tracker. This file is the whole application definition.

entity Team
  id        uuid       pk = uuid
  name      text       unique
  createdAt timestamp  = now

entity Person
  id        uuid       pk = uuid
  email     text       unique
  name      text
  teamId    -> Team
  createdAt timestamp  = now

entity Task
  id          uuid       pk = uuid
  title       text
  notes       text?
  status      enum TaskStatus(todo, doing, blocked, done) = todo
  priority    integer   = 3
  dueOn       date?
  assigneeId  -> Person
  teamId      -> Team
  createdAt   timestamp  = now
  unique(title, teamId)
